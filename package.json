{
  "name": "rn-safe-upgrade",
  "version": "1.0.0",
  "description": "React Native upgrade assistant with an auto-generated brief, dependency checks, template diffs and a local agent bridge.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack --no-lint",
    "start": "next start",
    "lint": "eslint",
    "export": "next build",
    "deploy": "next build && npx --yes gh-pages@6 -d out -t true",
    "refresh-data": "node scripts/refresh-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-diff-view": "^3.3.2",
    "react-dom": "19.1.0",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.7.1",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  },
  "keywords": [
    "react-native",
    "upgrade",
    "upgrade-helper",
    "dependency-compatibility",
    "agent",
    "cli",
    "bridge"
  ],
  "license": "MIT",
  "bin": {
    "rn-safe-upgrade": "./agent/cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@humanfs/node": "^0.16.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/type-utils": "^8.72.0",
    "@typescript-eslint/typescript-estree": "^8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "ajv@<6.14.0": "^6.14.0",
    "brace-expansion@<=1.1.20": "^1.1.21",
    "braces@<3.0.3": "^3.0.3",
    "fast-glob": "^3.3.3",
    "flatted@<=3.4.1": "^3.4.2",
    "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
    "lodash@<=4.17.23": "^4.18.1",
    "minimatch@<=3.1.3": "^3.1.4",
    "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
    "nanoid@<=3.3.17": "^3.3.18",
    "picomatch@<=2.3.1": "^2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "source-map-js@<1.2.2": "^1.2.2",
    "tar@<=7.5.20": "^7.5.21"
  }
}
